{
  "name": "ultra-light-ai",
  "displayName": "Vakra AI",
  "description": "An autonomous AI coding agent optimized for small 4B models — inline completions, agentic coding, voice, and RAG",
  "version": "0.1.0",
  "publisher": "ultra-light-ai",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=18.0.0"
  },
  "categories": [
    "Machine Learning",
    "Programming Languages",
    "Snippets",
    "Other"
  ],
  "keywords": [
    "AI",
    "copilot",
    "code completion",
    "gemini",
    "inline suggestions",
    "code assistant"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:ultra-light-ai-sidebar"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "ultra-light-ai.openSidebar",
        "title": "Vakra AI: Open Chat",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "ultra-light-ai.newChat",
        "title": "Vakra AI: New Chat",
        "icon": "$(add)"
      },
      {
        "command": "ultra-light-ai.switchModel",
        "title": "Vakra AI: Switch Model",
        "icon": "$(symbol-misc)"
      },
      {
        "command": "ultra-light-ai.inlineChat",
        "title": "Vakra AI: Explain Selection (Inline Chat)",
        "icon": "$(lightbulb)"
      },
      {
        "command": "ultra-light-ai.addFileContext",
        "title": "Vakra AI: Add Active File to Chat Context",
        "icon": "$(file-add)"
      },
      {
        "command": "ultra-light-ai.aiFix",
        "title": "Vakra AI: AI Quick Fix"
      },
      {
        "command": "ultra-light-ai.explainCode",
        "title": "Vakra AI: Explain Code"
      },
      {
        "command": "ultra-light-ai.refactorSelection",
        "title": "Vakra AI: Refactor Selection"
      },
      {
        "command": "ultra-light-ai.generateDocs",
        "title": "Vakra AI: Generate Documentation"
      },
      {
        "command": "ultra-light-ai.inlineEdit",
        "title": "Vakra AI: Inline Edit (Ctrl+K)"
      },
      {
        "command": "ultra-light-ai.fixTerminalError",
        "title": "Vakra AI: Fix Terminal Error",
        "icon": "$(warning)"
      },
      {
        "command": "ultra-light-ai.skeletonExpand",
        "title": "Vakra AI: Skeleton Expand",
        "icon": "$(zap)"
      },
      {
        "command": "ultra-light-ai.smartSearch",
        "title": "Vakra AI: Semantic Smart Search",
        "icon": "$(search)"
      }
    ],
    "keybindings": [
      {
        "command": "ultra-light-ai.openSidebar",
        "key": "ctrl+shift+a",
        "mac": "cmd+shift+a"
      },
      {
        "command": "ultra-light-ai.inlineChat",
        "key": "ctrl+shift+i",
        "mac": "cmd+shift+i",
        "when": "editorHasSelection"
      },
      {
        "command": "ultra-light-ai.newChat",
        "key": "ctrl+shift+n",
        "mac": "cmd+shift+n"
      },
      {
        "command": "ultra-light-ai.switchModel",
        "key": "ctrl+shift+m",
        "mac": "cmd+shift+m"
      },
      {
        "command": "ultra-light-ai.inlineEdit",
        "key": "ctrl+k",
        "mac": "cmd+k",
        "when": "editorTextFocus && editorHasSelection"
      },
      {
        "command": "ultra-light-ai.skeletonExpand",
        "key": "ctrl+shift+enter",
        "mac": "cmd+shift+enter",
        "when": "editorTextFocus"
      },
      {
        "command": "ultra-light-ai.smartSearch",
        "key": "ctrl+alt+f",
        "mac": "cmd+alt+f"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "ultra-light-ai.inlineChat",
          "when": "editorHasSelection",
          "group": "ultra-light-ai@1"
        },
        {
          "command": "ultra-light-ai.addFileContext",
          "group": "ultra-light-ai@2"
        }
      ],
      "view/title": [
        {
          "command": "ultra-light-ai.newChat",
          "when": "view == ultra-light-ai-sidebar",
          "group": "navigation"
        },
        {
          "command": "ultra-light-ai.switchModel",
          "when": "view == ultra-light-ai-sidebar",
          "group": "navigation"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ultra-light-ai-chat-panel",
          "title": "Vakra AI",
          "icon": "$(sparkle)"
        }
      ]
    },
    "views": {
      "ultra-light-ai-chat-panel": [
        {
          "type": "webview",
          "id": "ultra-light-ai-sidebar",
          "name": "Vakra AI"
        }
      ]
    },
    "configuration": {
      "title": "Vakra AI",
      "properties": {
        "ultraLightAI.geminiApiKey": {
          "type": "string",
          "default": "",
          "markdownDescription": "A comma-separated list of Google Gemini API Keys for Cloud operations and failover (e.g., key1,key2,key3)."
        },
        "ultraLightAI.enableInlineCompletions": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Enable Copilot-style inline code completions (ghost text)."
        },
        "ultraLightAI.enableHoverExplanations": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Enable AI-powered hover explanations (may increase API usage)."
        },
        "ultraLightAI.enableCodeActions": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Enable AI-powered code actions (Quick Fix, Refactor, etc.)."
        },
        "ultraLightAI.streamingEnabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Enable streaming responses in chat (token-by-token display)."
        },
        "ultraLightAI.ignoreFolders": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "node_modules",
            ".git",
            "dist",
            "out",
            "build",
            ".next",
            ".vscode"
          ],
          "markdownDescription": "List of folder names to ignore during AI background indexing and RAG file watching."
        }
      }
    }
  },
  "scripts": {
    "build:css": "npx tailwindcss -i ./src/webview/input.css -o ./dist/tailwind.css --minify",
    "compile": "npm run build:css && node esbuild.js",
    "watch": "npm run build:css && node esbuild.js --watch",
    "package": "npm run build:css && node esbuild.js --production",
    "pretest": "npm run compile && tsc -p .",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@highlightjs/cdn-assets": "^11.9.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^18.19.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.20.2",
    "marked": "^12.0.0",
    "mocha": "^11.7.6",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3"
  },
  "allowScripts": {
    "esbuild@0.20.2": true
  },
  "dependencies": {
    "puppeteer-core": "^25.12.0"
  }
}
